{
    "name": "diffoscope-analysers",
    "buildsystem": "simple",
    "build-commands": [],
    "modules": [
        {
            "name": "tinyxxd",
            "buildsystem": "simple",
            "build-commands": [
                "make install PREFIX=${FLATPAK_DEST}",
                "ln -sfv ${FLATPAK_DEST}/bin/tinyxxd ${FLATPAK_DEST}/bin/xxd"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/xyproto/tinyxxd/archive/refs/tags/v1.3.7.tar.gz",
                    "sha256": "fdf13a11a27ca794a01d806303ace2ebb074a337764e84222812ac5997a97aed",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/xyproto/tinyxxd/releases/latest",
                        "version-query": ".tag_name",
                        "url-query": "\"https://github.com/xyproto/tinyxxd/archive/refs/tags/\\($version).tar.gz\""
                    }
                }
            ]
        },
        {
            "name": "binwalk",
            "buildsystem": "simple",
            "build-options": {
                "append-path": "/usr/lib/sdk/rust-stable/bin",
                "env": {
                    "CARGO_HOME": "/run/build/binwalk/cargo"
                }
            },
            "build-commands": [
                "cargo fetch --locked --offline",
                "cargo build --release --locked --offline",
                "install -Dm0755 target/release/binwalk ${FLATPAK_DEST}/bin/binwalk"
            ],
            "sources": [
                "cargo-sources-binwalk.json",
                {
                    "type": "archive",
                    "url": "https://github.com/ReFirmLabs/binwalk/archive/refs/tags/v3.1.0.tar.gz",
                    "sha256": "06f595719417b70a592580258ed980237892eadc198e02363201abe6ca59e49a",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/ReFirmLabs/binwalk/releases/latest",
                        "version-query": ".tag_name",
                        "url-query": "\"https://github.com/ReFirmLabs/binwalk/archive/refs/tags/\\($version).tar.gz\""
                    }
                }
            ]
        },
        {
            "name": "libslang",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.jedsoft.org/releases/slang/slang-2.3.3.tar.bz2",
                    "sha256": "f9145054ae131973c61208ea82486d5dd10e3c5cdad23b7c4a0617743c8f5a18",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 4829,
                        "url-template": "https://www.jedsoft.org/releases/slang/slang-$version.tar.bz2"
                    }
                }
            ]
        },
        {
            "name": "libcaca",
            "config-opts": [
                "--disable-doc",
                "--disable-python",
                "--disable-ruby",
                "--disable-static"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "http://caca.zoy.org/files/libcaca/libcaca-0.99.beta19.tar.gz",
                    "mirror-urls": [
                        "https://distfiles.alpinelinux.org/distfiles/v3.12/libcaca-0.99.beta19.tar.gz"
                    ],
                    "sha256": "128b467c4ed03264c187405172a4e83049342cc8cc2f655f53a2d0ee9d3772f4"
                },
                {
                    "type": "patch",
                    "path": "patches/libcaca-CVE-2022-0856.patch"
                }
            ]
        },
        {
            "name": "fontforge",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DENABLE_GUI=OFF",
                "-DENABLE_LIBSPIRO=OFF",
                "-DENABLE_DOCS=OFF",
                "-DBUILD_TESTING=OFF"
            ],
            "cleanup": [
                "/share/applications",
                "/share/doc",
                "/share/icons",
                "/share/metainfo",
                "/share/mime"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/fontforge/fontforge/releases/download/20251009/fontforge-20251009.tar.xz",
                    "sha256": "69046500185a5581b58139dfad30c0b3d8128f00ebbfddc31f2fcf877e329e52",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 5807,
                        "url-template": "https://github.com/fontforge/fontforge/releases/download/$version/fontforge-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "node",
            "buildsystem": "simple",
            "build-commands": [
                "cp -a /usr/lib/sdk/node24/bin/* ${FLATPAK_DEST}/bin",
                "cp -a /usr/lib/sdk/node24/lib/* ${FLATPAK_DEST}/lib",
                "cp -ra /usr/lib/sdk/node24/share/yarn ${FLATPAK_DEST}/share"
            ]
        },
        {
            "name": "electron-asar",
            "buildsystem": "simple",
            "build-options": {
                "env": {
                    "XDG_CACHE_HOME": "/run/build/electron-asar/flatpak-node/cache",
                    "ELECTRON_SKIP_BINARY_DOWNLOAD": "1"
                }
            },
            "build-commands": [
                "mkdir -p ${FLATPAK_DEST}/lib/asar/node_modules",
                "HOME=$PWD yarn config --offline set yarn-offline-mirror $FLATPAK_BUILDER_BUILDDIR/flatpak-node/yarn-mirror",
                "yarn install --frozen-lockfile --offline",
                "yarn install --frozen-lockfile --offline --prod --modules-folder ${FLATPAK_DEST}/lib/asar/node_modules",
                "yarn build",
                "cp -ra lib bin ${FLATPAK_DEST}/lib/asar",
                "cp package.json ${FLATPAK_DEST}/lib/asar",
                "install -Dm0755 exec-asar ${FLATPAK_DEST}/bin/asar"
            ],
            "sources": [
                "electron-asar-yarn-sources.json",
                {
                    "type": "archive",
                    "url": "https://github.com/electron/asar/archive/refs/tags/v4.0.1.tar.gz",
                    "sha256": "b8b40ad6a61986e161b8d0b5eae00aed2d8b80430c126eb4dfe50c5803c2bd21",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/electron/asar/releases/latest",
                        "version-query": ".tag_name",
                        "url-query": "\"https://github.com/electron/asar/archive/refs/tags/\\($version).tar.gz\""
                    }
                },
                {
                    "type": "script",
                    "dest-filename": "exec-asar",
                    "commands": [
                        "exec node /app/lib/asar/bin/asar.mjs \"$@\""
                    ]
                }
            ]
        }
    ]
}
